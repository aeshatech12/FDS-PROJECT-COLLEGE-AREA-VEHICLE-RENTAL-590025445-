from pathlib import Path
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score, accuracy_score, confusion_matrix
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.feature_selection import SelectKBest, f_regression


# ==================== 1. SETUP ====================
FILE_NAME = "vehicle_rental_v3.csv"
sns.set_theme(style="whitegrid")
pd.set_option("display.max_columns", 12)
pd.set_option("display.width", 120)


def heading(title):
    print("\n" + "=" * 70)
    print(title)
    print("=" * 70)


def show_chart(title):
    
    plt.title(title)
    plt.tight_layout()
    plt.show(block=True)
    plt.close()


def decision(p_value):
    if p_value < 0.05:
        return "Reject H0 (significant at 5% level)"
    return "Fail to reject H0 (not significant at 5% level)"


# ==================== 2. LOAD AND UNDERSTAND DATA ====================

if not Path(FILE_NAME).exists():
    raise FileNotFoundError(
        f"Place {FILE_NAME} in the same folder and run the script from there."
    )

df = pd.read_csv("vehicle_rental_v3.csv")
print("Dataset shape:", df.shape)
print("\nFirst 5 rows:\n", df.head())
print("\nLast 5 rows:\n", df.tail())
print("\nColumn names:\n", df.columns.tolist())
print("\nColumn data types:\n", df.dtypes)
print("\nUnique values per column:\n", df.nunique())


# ==================== 3. DATA CLEANING ====================
heading("DATA CLEANING AND PREPROCESSING")
print("Missing values BEFORE cleaning:\n", df.isnull().sum()[lambda s: s > 0])
print("Duplicate rows BEFORE cleaning:", df.duplicated().sum())

data = df.copy()
data = data.dropna(how="all")
data = data.drop_duplicates()

# Standardize spaces in text fields.
for column in data.select_dtypes(include="object").columns:
    data[column] = data[column].str.strip()

# Convert percentages such as '82%' into the number 82.
data["Fuel_Battery_Level"] = pd.to_numeric(
    data["Fuel_Battery_Level"].astype(str).str.replace("%", "", regex=False),
    errors="coerce"
)

# The fallback supports day-month-year values if slash-formatted dates appear.
def parse_rental_date(value):
    if pd.isna(value):
        return pd.NaT
    value = str(value).strip()
    if "/" in value:
        return pd.to_datetime(value, format="%m/%d/%Y", errors="coerce")
    return pd.to_datetime(value, format="%d-%m-%Y", errors="coerce")


data["Rental_Date"] = data["Rental_Date"].apply(parse_rental_date)
data["Booking_Hour"] = pd.to_datetime(
    data["Booking_Time"], format="%I:%M %p", errors="coerce"
).dt.hour

# Fill numerical missing values with the median and categorical with the mode.
numeric_columns = [
    "Distance_km", "Duration_min", "Rental_Price_Rs", "Customer_Rating",
    "Vehicle_Available_Count", "Fuel_Battery_Level", "Expected_Duration_min"
]
for column in numeric_columns:
    data[column] = pd.to_numeric(data[column], errors="coerce")
    data[column] = data[column].fillna(data[column].median())

categorical_columns = ["Payment_Mode", "Traffic_Level", "Weather", "Demand_Level"]
for column in categorical_columns:
    data[column] = data[column].fillna(data[column].mode().iloc[0])

# Discarding records with invalid dates/times.
data = data.dropna(subset=["Rental_Date", "Booking_Hour"])
data = data[
    (data["Distance_km"] > 0)
    & (data["Duration_min"] > 0)
    & (data["Rental_Price_Rs"] > 0)
    & (data["Customer_Rating"].between(1, 5))
].copy()

print("\nMissing values AFTER cleaning:", data.isnull().sum().sum())
print("Duplicate rows AFTER cleaning:", data.duplicated().sum())
print("Cleaned dataset shape:", data.shape)

# Detect potential outliers.
q1 = data["Rental_Price_Rs"].quantile(0.25)
q3 = data["Rental_Price_Rs"].quantile(0.75)
iqr = q3 - q1
lower_limit = q1 - 1.5 * iqr
upper_limit = q3 + 1.5 * iqr
outliers = data[
    (data["Rental_Price_Rs"] < lower_limit)
    | (data["Rental_Price_Rs"] > upper_limit)
]
print("Potential price outliers (IQR):", len(outliers))

# ==================== 4. DESCRIPTIVE STATISTICS ====================
heading("DESCRIPTIVE STATISTICS")
print(data[numeric_columns].describe().round(2))
price = data["Rental_Price_Rs"]
print("\nMean price: Rs", round(price.mean(), 2))
print("Median price: Rs", round(price.median(), 2))
print("Mode price: Rs", price.mode().iloc[0])
print("Price variance:", round(price.var(), 2))
print("Price standard deviation:", round(price.std(), 2))
print("Price skewness:", round(price.skew(), 2))
print("Distance-price correlation:", round(data["Distance_km"].corr(price), 3))


# ==================== 5. EXPLORATORY ANALYSIS ====================
heading("EXPLORATORY DATA ANALYSIS")
print("Vehicle type counts:\n", data["Vehicle_Type"].value_counts())
print("\nDemand level counts:\n", data["Demand_Level"].value_counts())
print("\nAverage price by vehicle:\n",
      data.groupby("Vehicle_Type")["Rental_Price_Rs"].mean().round(2))
print("\nAverage rating by vehicle:\n",
      data.groupby("Vehicle_Type")["Customer_Rating"].mean().round(2))
print("\nWeather vs demand:\n", pd.crosstab(data["Weather"], data["Demand_Level"]))


# ==================== 6. PROBABILITY ====================
heading("PROBABILITY ANALYSIS")
high_demand = data["Demand_Level"] == "High"
accepted = data["Recommendation_Accepted"] == "Yes"
print("P(High demand):", round(high_demand.mean(), 4))
print("P(Car rental):", round((data["Vehicle_Type"] == "Car").mean(), 4))
print("P(Recommendation accepted):", round(accepted.mean(), 4))
if high_demand.sum() > 0:
    conditional = accepted[high_demand].mean()
    print("P(Accepted | High demand):", round(conditional, 4))


# ==================== 7. FEATURE ENGINEERING ====================
heading("FEATURE ENGINEERING")
data["Price_per_km"] = data["Rental_Price_Rs"] / data["Distance_km"]
data["Speed_kmph"] = data["Distance_km"] / (data["Duration_min"] / 60)
data["Duration_Difference"] = (
    data["Duration_min"] - data["Expected_Duration_min"]
)
data["Peak_Hour"] = data["Booking_Hour"].isin([8, 9, 10, 16, 17, 18]).astype(int)
print(data[["Price_per_km", "Speed_kmph", "Duration_Difference", "Peak_Hour"]].head())



# PMF, CDF, expectation and moments.
vehicle_pmf = data["Vehicle_Type"].value_counts(normalize=True)
print("\nEmpirical PMF of vehicle type:\n", vehicle_pmf.round(4))
mu = price.mean()
sigma = price.std(ddof=1)
print("E[Price] =", round(mu, 2))
print("E[Price^2] =", round(np.mean(price ** 2), 2))
print("Variance =", round(price.var(ddof=1), 2))
print("Skewness =", round(stats.skew(price, bias=False), 3))
print("Empirical CDF at median =", round((price <= price.median()).mean(), 4))
print("Normal PDF at mean =", round(stats.norm.pdf(mu, loc=mu, scale=sigma), 6))
print("Binomial P(3 acceptances in 5) =", round(stats.binom.pmf(3, 5, accepted.mean()), 4))

# Random vector, covariance and correlation.
print("\nCovariance matrix (Distance, Price):\n", data[["Distance_km", "Rental_Price_Rs"]].cov().round(3))
print("Correlation matrix:\n", data[["Distance_km", "Rental_Price_Rs"]].corr().round(3))

# Sampling distribution, CLT and confidence interval.
rng = np.random.default_rng(42)
sample_size = min(30, len(price))
sample_means = np.array([rng.choice(price.to_numpy(), sample_size, replace=True).mean() for _ in range(1000)])
print("\nMean of bootstrap sample means =", round(sample_means.mean(), 2))
print("Standard error estimate =", round(sample_means.std(ddof=1), 2))
se = stats.sem(price)
tcrit = stats.t.ppf(0.975, len(price) - 1)
print("95% CI for mean price =", (round(mu - tcrit * se, 2), round(mu + tcrit * se, 2)))

# Approximate Z test. Population SD is unavailable, so sample SD is used as an estimate.
z = (mu - 200) / (sigma / np.sqrt(len(price)))
z_p = 2 * (1 - stats.norm.cdf(abs(z)))
print("Approximate Z test: z =", round(z, 4), "p =", round(z_p, 6), decision(z_p))

# F test for equality of two variances.
car_f = data.loc[data["Vehicle_Type"] == "Car", "Rental_Price_Rs"]
scooter_f = data.loc[data["Vehicle_Type"] == "Scooter", "Rental_Price_Rs"]
if len(car_f) > 1 and len(scooter_f) > 1:
    f_stat = car_f.var(ddof=1) / scooter_f.var(ddof=1)
    f_cdf = stats.f.cdf(f_stat, len(car_f)-1, len(scooter_f)-1)
    f_p = min(1.0, 2 * min(f_cdf, 1-f_cdf))
    print("F variance test: F =", round(f_stat, 4), "p =", round(f_p, 6), decision(f_p))

# Feature subset selection and PCA dimensionality reduction.
fe = data[["Distance_km", "Duration_min", "Customer_Rating", "Vehicle_Available_Count",
           "Fuel_Battery_Level", "Expected_Duration_min", "Booking_Hour", "Peak_Hour"]].copy()
selector = SelectKBest(f_regression, k=4).fit(fe, data["Rental_Price_Rs"])
print("Selected features =", fe.columns[selector.get_support()].tolist())
scaled_fe = StandardScaler().fit_transform(fe)
pca = PCA(n_components=2).fit(scaled_fe)
print("PCA explained variance =", np.round(pca.explained_variance_ratio_, 4),
      "Total =", round(pca.explained_variance_ratio_.sum()*100, 2), "%")


# ==================== 8. VISUALIZATIONS ====================

# 1. Bar chart
plt.figure(figsize=(8, 5))
sns.countplot(data=data, x="Vehicle_Type", order=data["Vehicle_Type"].value_counts().index, color="steelblue")
plt.xlabel("Vehicle type")
plt.ylabel("Number of rentals")
show_chart("1. Most Popular Vehicle Types")

# 2. Histogram
plt.figure(figsize=(8, 5))
sns.histplot(data["Rental_Price_Rs"], bins=15, kde=True, color="steelblue")
