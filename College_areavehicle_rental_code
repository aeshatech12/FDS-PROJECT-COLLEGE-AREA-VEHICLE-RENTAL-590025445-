show_chart("2. Rental Price Distribution")

# 3. Box plot
plt.figure(figsize=(8, 5))
sns.boxplot(data=data, x="Vehicle_Type", y="Rental_Price_Rs", color="steelblue")
plt.xlabel("Vehicle type")
plt.ylabel("Rental price (Rs)")
show_chart("3. Rental Price by Vehicle Type")

# 4. Scatter plot
plt.figure(figsize=(8, 5))
sns.scatterplot(data=data, x="Distance_km", y="Rental_Price_Rs", hue="Vehicle_Type")
plt.xlabel("Distance (km)")
plt.ylabel("Rental price (Rs)")
show_chart("4. Distance vs Rental Price")

# 5. Correlation heatmap
plt.figure(figsize=(9, 6))
heatmap_columns = [
    "Distance_km", "Duration_min", "Rental_Price_Rs",
    "Customer_Rating", "Vehicle_Available_Count", "Expected_Duration_min"
]
sns.heatmap(data[heatmap_columns].corr(), annot=True, fmt=".2f", cmap="coolwarm")
show_chart("5. Correlation Heatmap")

# 6. Line chart
plt.figure(figsize=(9, 5))
daily_counts = data.groupby("Rental_Date").size().sort_index()
plt.plot(daily_counts.index, daily_counts.values, marker="o")
plt.xlabel("Rental date")
