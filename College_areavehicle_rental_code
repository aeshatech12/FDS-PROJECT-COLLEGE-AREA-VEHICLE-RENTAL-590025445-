show_chart("6. Daily Rental Trend")


# ==================== 9. HYPOTHESIS TESTS ====================
heading("HYPOTHESIS TESTING (ALPHA = 0.05)")

# One-sample t-test: mean rental price vs Rs 200.
t_value, p_value = stats.ttest_1samp(data["Rental_Price_Rs"], popmean=200)
print("\nOne-sample t-test: H0: mean price = Rs 200")
print("t =", round(t_value, 4), "p =", round(p_value, 6))
print(decision(p_value))

# Welch independent t-test: car prices vs scooter prices.
car_prices = data.loc[data["Vehicle_Type"] == "Car", "Rental_Price_Rs"]
scooter_prices = data.loc[data["Vehicle_Type"] == "Scooter", "Rental_Price_Rs"]
t_value, p_value = stats.ttest_ind(car_prices, scooter_prices, equal_var=False)
print("\nIndependent t-test: H0: mean car price = mean scooter price")
print("t =", round(t_value, 4), "p =", round(p_value, 6))
print(decision(p_value))

# Chi-square: association between vehicle type and demand.
contingency = pd.crosstab(data["Vehicle_Type"], data["Demand_Level"])
chi2, p_value, dof, expected = stats.chi2_contingency(contingency)
print("\nChi-square: H0: vehicle type and demand are independent")
print("Chi-square =", round(chi2, 4), "df =", dof, "p =", round(p_value, 6))
print("Expected frequency cells below 5:", int((expected < 5).sum()))
print(decision(p_value))

# One-way ANOVA: price across demand levels.
demand_groups = [
    group["Rental_Price_Rs"].values
    for _, group in data.groupby("Demand_Level")
]
f_value, p_value = stats.f_oneway(*demand_groups)
print("\nOne-way ANOVA: H0: mean price is equal across demand levels")
print("F =", round(f_value, 4), "p =", round(p_value, 6))
print(decision(p_value))

# Two-way ANOVA (Vehicle Type and Demand Level).
try:
    import statsmodels.api as sm
    from statsmodels.formula.api import ols
    fit2 = ols("Rental_Price_Rs ~ C(Vehicle_Type) + C(Demand_Level) + C(Vehicle_Type):C(Demand_Level)", data=data).fit()
    print("\nTwo-way ANOVA:\n", sm.stats.anova_lm(fit2, typ=2).round(4))
except ImportError:
    print("Two-way ANOVA skipped: install statsmodels to run it.")

# ==================== 10. LINEAR REGRESSION ====================
heading("LINEAR REGRESSION: RENTAL PRICE PREDICTION")

features = ["Distance_km", "Vehicle_Type"]
X = pd.get_dummies(data[features], columns=["Vehicle_Type"], drop_first=True, dtype=int)
y = data["Rental_Price_Rs"]

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

model = LinearRegression()
model.fit(X_train, y_train)
y_pred = model.predict(X_test)

print("Intercept:", round(model.intercept_, 3))
print("Coefficients:")
for name, coefficient in zip(X.columns, model.coef_):
    print(f"  {name:25s}: {coefficient:9.3f}")

mae = mean_absolute_error(y_test, y_pred)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
r2 = r2_score(y_test, y_pred)
print("\nMAE :", round(mae, 2))
print("RMSE:", round(rmse, 2))
print("R2  :", round(r2, 4))

comparison = pd.DataFrame({
    "Actual": y_test.to_numpy(),
    "Predicted": np.round(y_pred, 2)
})
print("\nSample Actual vs Predicted Prices:\n", comparison.head(10).to_string(index=False))

# 7. Actual vs predicted chart
plt.figure(figsize=(8, 5))
sns.scatterplot(x=y_test, y=y_pred)
minimum = min(y_test.min(), y_pred.min())
maximum = max(y_test.max(), y_pred.max())
plt.plot([minimum, maximum], [minimum, maximum], "r--", label="Perfect prediction")
plt.xlabel("Actual price (Rs)")
plt.ylabel("Predicted price (Rs)")
plt.legend()
show_chart("7. Actual vs Predicted Rental Prices")

# 8. Residual plot
residuals = y_test.to_numpy() - y_pred
plt.figure(figsize=(8, 5))
sns.scatterplot(x=y_pred, y=residuals)
plt.axhline(0, color="red", linestyle="--")
plt.xlabel("Predicted price (Rs)")
plt.ylabel("Residual: actual - predicted (Rs)")
show_chart("8. Regression Residuals")


# ==================== 11. OPTIONAL PREDICTION ====================
heading("TRY A RENTAL PRICE PREDICTION")
answer = input("Would you like to predict a price? (y/n): ").strip().lower()
if answer == "y":
    try:
        distance = float(input("Enter distance in km: "))
        vehicle = input("Vehicle type (Bike/Scooter/Car/E-Scooter): ").strip()
        available_types = data["Vehicle_Type"].unique().tolist()

        if distance <= 0:
            print("Distance must be positive.")
        elif vehicle not in available_types:
            print("Choose one of:", ", ".join(available_types))
        else:
            new_rental = pd.DataFrame({
                "Distance_km": [distance],
                "Vehicle_Type": [vehicle]
            })
            # Matching the same dummy columns used during training.
            new_rental = pd.DataFrame(0, index=[0], columns=X.columns)
            new_rental.loc[0, "Distance_km"] = distance
            dummy_name = "Vehicle_Type_" + vehicle
            if dummy_name in new_rental.columns:
                new_rental.loc[0, dummy_name] = 1
            predicted_price = model.predict(new_rental)[0]
            print(f"Estimated rental price: Rs {predicted_price:.2f}")
    except ValueError:
        print("Please enter a valid numerical distance.")
